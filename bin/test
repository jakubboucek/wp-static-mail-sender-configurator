#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
target=${1:-}
case "$target" in
    modern|legacy) shift ;;
    *) echo 'Usage: bin/test modern|legacy [PHPUnit arguments]' >&2; exit 2 ;;
esac
bin/dev "$target" build tests
bin/dev "$target" run --rm tests --configuration /workspace/phpunit.xml.dist "$@"
