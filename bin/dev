#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
target=${1:-}
case "$target" in
    modern|legacy) shift ;;
    *) echo 'Usage: bin/dev modern|legacy <docker compose arguments>' >&2; exit 2 ;;
esac
exec docker compose --project-name "static-mail-$target" --env-file "docker/$target.env" "$@"
